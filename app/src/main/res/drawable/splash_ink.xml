<?xml version="1.0" encoding="utf-8"?>
<!-- Shimmer 启动页水墨晕染背景 -->
<!-- 宣纸底色 + 极淡墨点晕开 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 宣纸底色 -->
    <item android:drawable="@color/launcher_background" />
    <!-- 墨点 1：左上 -->
    <item android:gravity="top|start" android:top="120dp" android:left="60dp">
        <shape android:shape="oval">
            <solid android:color="#0A1a1a1a" />
            <size android:width="120dp" android:height="120dp" />
        </shape>
    </item>
    <!-- 墨点 2：右下 -->
    <item android:gravity="bottom|end" android:bottom="160dp" android:right="80dp">
        <shape android:shape="oval">
            <solid android:color="#0E1a1a1a" />
            <size android:width="180dp" android:height="180dp" />
        </shape>
    </item>
    <!-- 墨点 3：中上（最淡） -->
    <item android:gravity="top|center_horizontal" android:top="260dp">
        <shape android:shape="oval">
            <solid android:color="#071a1a1a" />
            <size android:width="80dp" android:height="80dp" />
        </shape>
    </item>
</layer-list>
